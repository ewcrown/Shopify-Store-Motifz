<script>
  // Select all branch-title elements
  document.querySelectorAll('.branch-title').forEach(function (branchTitle) {
    branchTitle.addEventListener('click', function () {
      var branchAccordion = this.closest('.branch-accordion');
      var currentBranch = this.nextElementSibling;
      var allbranchAccordion = document.querySelectorAll('.branch-accordion');

      // Remove 'is-open' and 'active' classes from all branches except the clicked one
      allbranchAccordion.forEach(function (accordion) {
        if (accordion !== branchAccordion) {
          accordion.classList.remove('is-open');
          accordion.querySelectorAll('.branch').forEach(function (branch) {
            branch.classList.remove('active');
          });
        }
      });

      // Toggle the 'active' class on the current branch
      currentBranch.classList.toggle('active');

      // If the current branch becomes active, add 'is-open' to the accordion
      if (currentBranch.classList.contains('active')) {
        branchAccordion.classList.add('is-open');
      } else {
        branchAccordion.classList.remove('is-open');
      }
    });
  });

