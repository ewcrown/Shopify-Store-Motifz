{% comment %}
  Section: Linked Image Grid (4 columns, flex version)
  Minimal settings: each block has only Image + Link
  Images display at natural aspect ratio (no crop).
{% endcomment %}

<section id="linked-image-grid-{{ section.id }}" class="linked-image-grid">
  <div class="page-width">
    <div class="lig-flex">
      {% for block in section.blocks %}
        {% assign img = block.settings.image %}
        {% assign link = block.settings.link %}
        <div class="lig-item" {{ block.shopify_attributes }}>
          {% if link != blank %}<a class="lig-link" href="{{ link }}">{% endif %}
            <div class="lig-media">
              {% if img != blank %}
                {{ img | image_url: width: 2000 | image_tag:
                  loading: 'lazy',
                  alt: img.alt | default: 'Image',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 100vw',
                  widths: '400,600,800,1000,1200,1600,2000'
                }}
              {% else %}
                <div class="lig-placeholder" role="img" aria-label="Placeholder"></div>
              {% endif %}
            </div>
          {% if link != blank %}</a>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <style>
    #linked-image-grid-{{ section.id }} {
      padding: 60px 0;
    }

    /* Flexbox container */
    #linked-image-grid-{{ section.id }} .lig-flex {
      display: flex;
      flex-wrap: wrap;
      justify-content: center; /* centers items horizontally */
      gap: 16px;
    }

    /* 1 per row on mobile */
    #linked-image-grid-{{ section.id }} .lig-item {
      flex: 1 1 100%;
      max-width: 100%;
      box-sizing: border-box;
      display: flex;
      justify-content: center; /* center image/link inside the item */
      align-items: center;
    }

    /* 3 per row on tablet */
    @media (min-width: 750px) {
      #linked-image-grid-{{ section.id }} .lig-item {
        flex: 1 1 calc(33.333% - 16px);
        max-width: calc(33.333% - 16px);
      }
    }

    /* 4 per row on desktop */
    @media (min-width: 990px) {
      #linked-image-grid-{{ section.id }} .lig-item {
        flex: 1 1 calc(25% - 16px);
        max-width: calc(25% - 16px);
      }
    }

    #linked-image-grid-{{ section.id }} .lig-link {
      display: block;
      text-decoration: none;
      color: inherit;
      width: 100%;
    }

    /* Natural image sizing */
    #linked-image-grid-{{ section.id }} .lig-media {
      width: 100%;
    }
    #linked-image-grid-{{ section.id }} .lig-media img {
      width: 100%;
      height: auto;
      display: block;
    }

    #linked-image-grid-{{ section.id }} .lig-placeholder {
      width: 100%;
      padding-top: 75%; /* fallback 4:3 */
      background: repeating-linear-gradient(
        45deg,
        #e5e5e5,
        #e5e5e5 10px,
        #f5f5f5 10px,
        #f5f5f5 20px
      );
    }
  </style>
</section>

{% schema %}
{
  "name": "Linked image grid",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Image item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Linked image grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}